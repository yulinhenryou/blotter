{
  "components": {
    "schemas": {
      "Action": {
        "additionalProperties": false,
        "description": "One action. ``amount_to_chips`` is the seat's total on this street after the action.",
        "properties": {
          "all_in": {
            "default": false,
            "title": "All In",
            "type": "boolean"
          },
          "amount_approximate": {
            "default": false,
            "title": "Amount Approximate",
            "type": "boolean"
          },
          "amount_to_chips": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount To Chips"
          },
          "ante_chips": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ante Chips"
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "seat": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Seat",
            "type": "integer"
          },
          "street": {
            "$ref": "#/components/schemas/Street"
          }
        },
        "required": [
          "street",
          "seat",
          "kind"
        ],
        "title": "Action",
        "type": "object"
      },
      "ActionKind": {
        "description": "What a seat did. The ``post_*`` kinds are forced bets (``docs/MATH.md`` \u00a71.5).",
        "enum": [
          "post_ante",
          "post_small_blind",
          "post_big_blind",
          "post_straddle",
          "fold",
          "check",
          "call",
          "bet",
          "raise"
        ],
        "title": "ActionKind",
        "type": "string"
      },
      "Ante": {
        "additionalProperties": false,
        "description": "An ante: every dealt-in seat posts ``chips``, or the big blind posts it once.",
        "properties": {
          "chips": {
            "minimum": 1.0,
            "title": "Chips",
            "type": "integer"
          },
          "kind": {
            "$ref": "#/components/schemas/AnteKind"
          }
        },
        "required": [
          "kind",
          "chips"
        ],
        "title": "Ante",
        "type": "object"
      },
      "AnteKind": {
        "description": "Who posts the ante.",
        "enum": [
          "per_player",
          "big_blind"
        ],
        "title": "AnteKind",
        "type": "string"
      },
      "Board": {
        "additionalProperties": false,
        "description": "Community cards; ``None`` for a street that was not dealt.",
        "properties": {
          "flop": {
            "anyOf": [
              {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "examples": [
                      "Ks",
                      "Td",
                      "2c"
                    ],
                    "pattern": "^[2-9TJQKA][shdc]$",
                    "type": "string"
                  },
                  {
                    "examples": [
                      "Ks",
                      "Td",
                      "2c"
                    ],
                    "pattern": "^[2-9TJQKA][shdc]$",
                    "type": "string"
                  },
                  {
                    "examples": [
                      "Ks",
                      "Td",
                      "2c"
                    ],
                    "pattern": "^[2-9TJQKA][shdc]$",
                    "type": "string"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flop"
          },
          "river": {
            "anyOf": [
              {
                "examples": [
                  "Ks",
                  "Td",
                  "2c"
                ],
                "pattern": "^[2-9TJQKA][shdc]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "River"
          },
          "turn": {
            "anyOf": [
              {
                "examples": [
                  "Ks",
                  "Td",
                  "2c"
                ],
                "pattern": "^[2-9TJQKA][shdc]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn"
          }
        },
        "title": "Board",
        "type": "object"
      },
      "BoardSuits": {
        "description": "How the board's suits repeat (item 10).",
        "enum": [
          "rainbow",
          "two_tone",
          "flush_possible"
        ],
        "title": "BoardSuits",
        "type": "string"
      },
      "Completeness": {
        "additionalProperties": false,
        "description": "What the record does not know exactly. Derived; see ``docs/ARCHITECTURE.md`` \u00a77.3.",
        "properties": {
          "amounts_approximate": {
            "title": "Amounts Approximate",
            "type": "boolean"
          },
          "stacks_approximate": {
            "title": "Stacks Approximate",
            "type": "boolean"
          },
          "villain_cards_unknown": {
            "title": "Villain Cards Unknown",
            "type": "boolean"
          }
        },
        "required": [
          "villain_cards_unknown",
          "stacks_approximate",
          "amounts_approximate"
        ],
        "title": "Completeness",
        "type": "object"
      },
      "DecisionPointOut": {
        "description": "One hero decision: the index of its action in ``hand.actions`` and its situation key.\n\nEvery decision is unscored until the evaluator exists (M3b); ``unscored_reason`` says why.",
        "properties": {
          "action_seq": {
            "title": "Action Seq",
            "type": "integer"
          },
          "classifier_version": {
            "title": "Classifier Version",
            "type": "integer"
          },
          "scorable": {
            "title": "Scorable",
            "type": "boolean"
          },
          "situation": {
            "$ref": "#/components/schemas/Situation"
          },
          "unscored_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unscored Reason"
          }
        },
        "required": [
          "action_seq",
          "classifier_version",
          "situation",
          "scorable",
          "unscored_reason"
        ],
        "title": "DecisionPointOut",
        "type": "object"
      },
      "Depth": {
        "description": "Stack-to-pot ratio postflop, effective stack in big blinds preflop (item 8).",
        "enum": [
          "spr_lt_2",
          "spr_2_4",
          "spr_4_8",
          "spr_8_plus",
          "bb_lt_40",
          "bb_40_100",
          "bb_100_200",
          "bb_200_plus",
          "unknown"
        ],
        "title": "Depth",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HandDetail": {
        "description": "A stored hand (its canonical record) with its decision points.",
        "properties": {
          "decision_points": {
            "items": {
              "$ref": "#/components/schemas/DecisionPointOut"
            },
            "title": "Decision Points",
            "type": "array"
          },
          "hand": {
            "$ref": "#/components/schemas/HandRecord"
          }
        },
        "required": [
          "hand",
          "decision_points"
        ],
        "title": "HandDetail",
        "type": "object"
      },
      "HandRecord": {
        "additionalProperties": false,
        "description": "One hand, as captured or as stored.\n\nThe fields ``completeness``, ``rake_chips`` and ``hero_net_chips`` are derived: they are\nignored on input and filled in by :func:`review.domain.check.check`. ``rake_chips`` stays\n``None`` for a hand that ends at hero's fold, where the rake is not known.",
        "properties": {
          "actions": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "title": "Actions",
            "type": "array"
          },
          "board": {
            "$ref": "#/components/schemas/Board",
            "default": {}
          },
          "button_seat": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Button Seat",
            "type": "integer"
          },
          "client_seq": {
            "minimum": 0.0,
            "title": "Client Seq",
            "type": "integer"
          },
          "completeness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Completeness"
              },
              {
                "type": "null"
              }
            ]
          },
          "dealt_in_seats": {
            "items": {
              "maximum": 10.0,
              "minimum": 1.0,
              "type": "integer"
            },
            "title": "Dealt In Seats",
            "type": "array"
          },
          "ends_at_hero_fold": {
            "default": false,
            "title": "Ends At Hero Fold",
            "type": "boolean"
          },
          "hero_net_chips": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hero Net Chips"
          },
          "hero_seat": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Hero Seat",
            "type": "integer"
          },
          "id": {
            "format": "uuid7",
            "title": "Id",
            "type": "string"
          },
          "played_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Played At"
          },
          "rake_chips": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rake Chips"
          },
          "record_reason": {
            "$ref": "#/components/schemas/RecordReason"
          },
          "results": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Result"
            },
            "title": "Results",
            "type": "array"
          },
          "revision": {
            "default": 1,
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "schema_version": {
            "default": 2,
            "enum": [
              1,
              2
            ],
            "title": "Schema Version",
            "type": "integer"
          },
          "seats": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SeatEntry"
            },
            "title": "Seats",
            "type": "array"
          },
          "session_id": {
            "format": "uuid7",
            "title": "Session Id",
            "type": "string"
          },
          "source": {
            "const": "manual",
            "default": "manual",
            "title": "Source",
            "type": "string"
          },
          "stakes": {
            "$ref": "#/components/schemas/Stakes"
          },
          "table_size": {
            "maximum": 10.0,
            "minimum": 2.0,
            "title": "Table Size",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "session_id",
          "client_seq",
          "record_reason",
          "stakes",
          "table_size",
          "dealt_in_seats",
          "button_seat",
          "hero_seat"
        ],
        "title": "HandRecord",
        "type": "object"
      },
      "Health": {
        "description": "Response body of ``GET /api/v1/health``.",
        "properties": {
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "engine_version"
        ],
        "title": "Health",
        "type": "object"
      },
      "HighCard": {
        "description": "The board's highest rank.",
        "enum": [
          "ace",
          "broadway",
          "ten_or_lower"
        ],
        "title": "HighCard",
        "type": "string"
      },
      "InPosition": {
        "description": "Hero's place in the postflop order among the seats in hand (item 6).",
        "enum": [
          "ip",
          "oop",
          "middle"
        ],
        "title": "InPosition",
        "type": "string"
      },
      "Initiative": {
        "description": "Who made the last voluntary bet or raise on the previous street (item 7).",
        "enum": [
          "hero",
          "villain",
          "none"
        ],
        "title": "Initiative",
        "type": "string"
      },
      "IssueOut": {
        "description": "Why an item is invalid: a field path inside the item, a stable code and a sentence.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Path",
            "type": "array"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "title": "IssueOut",
        "type": "object"
      },
      "NewCard": {
        "description": "What the turn or river card did: the first of these that applies.",
        "enum": [
          "pairs_board",
          "completes_flush",
          "completes_straight",
          "overcard",
          "blank"
        ],
        "title": "NewCard",
        "type": "string"
      },
      "Pairing": {
        "description": "How the board's ranks repeat.",
        "enum": [
          "unpaired",
          "paired",
          "heavily_paired"
        ],
        "title": "Pairing",
        "type": "string"
      },
      "PlayerRecord": {
        "additionalProperties": false,
        "description": "Hero or a known opponent. Anonymous seats have no player.",
        "properties": {
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid7",
            "title": "Id",
            "type": "string"
          },
          "is_hero": {
            "default": false,
            "title": "Is Hero",
            "type": "boolean"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "revision": {
            "default": 1,
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "title": "PlayerRecord",
        "type": "object"
      },
      "Players": {
        "description": "Seats in hand at the decision, hero included (item 4).",
        "enum": [
          "heads_up",
          "three_way",
          "four_plus"
        ],
        "title": "Players",
        "type": "string"
      },
      "PositionGroup": {
        "description": "Coarse position, used for pooling (item 5).",
        "enum": [
          "early",
          "middle",
          "late",
          "blinds"
        ],
        "title": "PositionGroup",
        "type": "string"
      },
      "PotType": {
        "description": "Voluntary raises in the preflop round (item 3).",
        "enum": [
          "limped",
          "single_raised",
          "3bet",
          "4bet_plus"
        ],
        "title": "PotType",
        "type": "string"
      },
      "RecordReason": {
        "description": "Why the hand was logged (``docs/MATH.md`` \u00a74.5).",
        "enum": [
          "notable",
          "routine",
          "random_sample"
        ],
        "title": "RecordReason",
        "type": "string"
      },
      "Result": {
        "additionalProperties": false,
        "description": "Chips won by one seat. Seats without an entry won nothing.",
        "properties": {
          "seat": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Seat",
            "type": "integer"
          },
          "won_chips": {
            "minimum": 1.0,
            "title": "Won Chips",
            "type": "integer"
          }
        },
        "required": [
          "seat",
          "won_chips"
        ],
        "title": "Result",
        "type": "object"
      },
      "SeatEntry": {
        "additionalProperties": false,
        "description": "What is known about one dealt-in seat.",
        "properties": {
          "hole_cards": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "examples": [
                      "Ks",
                      "Td",
                      "2c"
                    ],
                    "pattern": "^[2-9TJQKA][shdc]$",
                    "type": "string"
                  },
                  {
                    "examples": [
                      "Ks",
                      "Td",
                      "2c"
                    ],
                    "pattern": "^[2-9TJQKA][shdc]$",
                    "type": "string"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hole Cards"
          },
          "player_id": {
            "anyOf": [
              {
                "format": "uuid7",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Id"
          },
          "seat": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Seat",
            "type": "integer"
          },
          "showed": {
            "default": false,
            "title": "Showed",
            "type": "boolean"
          },
          "stack_approximate": {
            "default": false,
            "title": "Stack Approximate",
            "type": "boolean"
          },
          "starting_stack_chips": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starting Stack Chips"
          }
        },
        "required": [
          "seat"
        ],
        "title": "SeatEntry",
        "type": "object"
      },
      "SessionRecord": {
        "additionalProperties": false,
        "description": "A playing session at one stake. Results come from buy-in and cash-out (``MATH.md`` \u00a74.5).",
        "properties": {
          "big_blind_chips": {
            "minimum": 1.0,
            "title": "Big Blind Chips",
            "type": "integer"
          },
          "buy_in_chips": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Buy In Chips"
          },
          "cash_out_chips": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cash Out Chips"
          },
          "chip_unit_minor": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chip Unit Minor"
          },
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "EUR"
            ],
            "title": "Currency"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "id": {
            "format": "uuid7",
            "title": "Id",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "revision": {
            "default": 1,
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "small_blind_chips": {
            "minimum": 1.0,
            "title": "Small Blind Chips",
            "type": "integer"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "venue_id": {
            "anyOf": [
              {
                "format": "uuid7",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue Id"
          }
        },
        "required": [
          "id",
          "started_at",
          "small_blind_chips",
          "big_blind_chips"
        ],
        "title": "SessionRecord",
        "type": "object"
      },
      "Situation": {
        "description": "The situation key of one decision point. ``None`` marks a column that does not apply.",
        "properties": {
          "depth": {
            "$ref": "#/components/schemas/Depth"
          },
          "facing_all_in": {
            "title": "Facing All In",
            "type": "boolean"
          },
          "in_position": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InPosition"
              },
              {
                "type": "null"
              }
            ]
          },
          "initiative": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Initiative"
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "title": "Line",
            "type": "string"
          },
          "players": {
            "$ref": "#/components/schemas/Players"
          },
          "position_group": {
            "$ref": "#/components/schemas/PositionGroup"
          },
          "position_label": {
            "title": "Position Label",
            "type": "string"
          },
          "pot_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PotType"
              },
              {
                "type": "null"
              }
            ]
          },
          "size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Size"
              },
              {
                "type": "null"
              }
            ]
          },
          "spot": {
            "$ref": "#/components/schemas/Spot"
          },
          "straddled": {
            "title": "Straddled",
            "type": "boolean"
          },
          "street": {
            "$ref": "#/components/schemas/Street"
          },
          "texture": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Texture"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "street",
          "spot",
          "pot_type",
          "players",
          "position_label",
          "position_group",
          "in_position",
          "initiative",
          "depth",
          "size",
          "facing_all_in",
          "texture",
          "line",
          "straddled"
        ],
        "title": "Situation",
        "type": "object"
      },
      "Size": {
        "description": "The bet hero faces: fraction of the pot postflop, multiple of the raised bet preflop.",
        "enum": [
          "small",
          "medium",
          "large",
          "overbet",
          "lt_2_5x",
          "2_5x_3_5x",
          "3_5x_5x",
          "5x_plus"
        ],
        "title": "Size",
        "type": "string"
      },
      "Spot": {
        "description": "What hero faces on this street (``MATH.md`` \u00a75.1, item 2).",
        "enum": [
          "unopened",
          "limped",
          "facing_open",
          "facing_3bet",
          "facing_4bet_plus",
          "no_bet",
          "facing_bet",
          "facing_raise"
        ],
        "title": "Spot",
        "type": "string"
      },
      "Stakes": {
        "additionalProperties": false,
        "description": "Forced bets of the hand, in chips.",
        "properties": {
          "ante": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ante"
              },
              {
                "type": "null"
              }
            ]
          },
          "big_blind_chips": {
            "minimum": 1.0,
            "title": "Big Blind Chips",
            "type": "integer"
          },
          "small_blind_chips": {
            "minimum": 1.0,
            "title": "Small Blind Chips",
            "type": "integer"
          },
          "straddles_chips": {
            "default": [],
            "items": {
              "minimum": 1.0,
              "type": "integer"
            },
            "title": "Straddles Chips",
            "type": "array"
          }
        },
        "required": [
          "small_blind_chips",
          "big_blind_chips"
        ],
        "title": "Stakes",
        "type": "object"
      },
      "Street": {
        "description": "Betting rounds, in order.",
        "enum": [
          "preflop",
          "flop",
          "turn",
          "river"
        ],
        "title": "Street",
        "type": "string"
      },
      "SyncBatch": {
        "additionalProperties": false,
        "description": "A batch from the phone. Each list may be empty or left out.",
        "properties": {
          "hands": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/HandRecord"
            },
            "title": "Hands",
            "type": "array"
          },
          "players": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PlayerRecord"
            },
            "title": "Players",
            "type": "array"
          },
          "sessions": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SessionRecord"
            },
            "title": "Sessions",
            "type": "array"
          },
          "venues": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/VenueRecord"
            },
            "title": "Venues",
            "type": "array"
          }
        },
        "title": "SyncBatch",
        "type": "object"
      },
      "SyncItemResult": {
        "description": "The result for one item of the batch.\n\n``index`` is the item's position in its list in the request. ``stored_revision`` is the\nrevision stored after the call (``None`` when nothing is stored for an invalid item).",
        "properties": {
          "id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "issues": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/IssueOut"
            },
            "title": "Issues",
            "type": "array"
          },
          "kind": {
            "enum": [
              "venue",
              "player",
              "session",
              "hand"
            ],
            "title": "Kind",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/SyncOutcome"
          },
          "stored_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stored Revision"
          }
        },
        "required": [
          "kind",
          "index",
          "id",
          "outcome",
          "stored_revision"
        ],
        "title": "SyncItemResult",
        "type": "object"
      },
      "SyncOutcome": {
        "description": "What happened to one item.",
        "enum": [
          "created",
          "replaced",
          "unchanged",
          "conflict",
          "invalid"
        ],
        "title": "SyncOutcome",
        "type": "string"
      },
      "SyncResponse": {
        "description": "One result per item, venues first, then players, sessions and hands, each in order.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SyncItemResult"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SyncResponse",
        "type": "object"
      },
      "Texture": {
        "description": "The board at the decision; ``new_card`` is ``None`` on the flop.",
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "high_card": {
            "$ref": "#/components/schemas/HighCard"
          },
          "new_card": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NewCard"
              },
              {
                "type": "null"
              }
            ]
          },
          "pairing": {
            "$ref": "#/components/schemas/Pairing"
          },
          "suits": {
            "$ref": "#/components/schemas/BoardSuits"
          },
          "texture_class": {
            "$ref": "#/components/schemas/TextureClass"
          }
        },
        "required": [
          "suits",
          "pairing",
          "high_card",
          "connected",
          "texture_class",
          "new_card"
        ],
        "title": "Texture",
        "type": "object"
      },
      "TextureClass": {
        "description": "The pooled texture: the first of these that applies.",
        "enum": [
          "paired",
          "flush_possible",
          "connected",
          "two_tone",
          "dry"
        ],
        "title": "TextureClass",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VenueKind": {
        "description": "Where a session is played.",
        "enum": [
          "live",
          "online"
        ],
        "title": "VenueKind",
        "type": "string"
      },
      "VenueRecord": {
        "additionalProperties": false,
        "description": "A card room or an online site.",
        "properties": {
          "id": {
            "format": "uuid7",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/VenueKind"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "default": 1,
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "timezone": {
            "examples": [
              "Europe/Vienna"
            ],
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "timezone"
        ],
        "title": "VenueRecord",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Blotter API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/hands/{hand_id}": {
      "get": {
        "description": "Return one hand with its decision points.",
        "operationId": "get_hand_api_v1_hands__hand_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "hand_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Hand Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such hand"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Hand"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Report liveness and the version of the Rust engine behind the API.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/players": {
      "get": {
        "description": "List every player, hero first, then by display name.",
        "operationId": "get_players_api_v1_players_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlayerRecord"
                  },
                  "title": "Response Get Players Api V1 Players Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Players"
      }
    },
    "/api/v1/sessions": {
      "get": {
        "description": "List every session, the most recent start first.",
        "operationId": "get_sessions_api_v1_sessions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionRecord"
                  },
                  "title": "Response Get Sessions Api V1 Sessions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Sessions"
      }
    },
    "/api/v1/sessions/{session_id}": {
      "get": {
        "description": "Return one session.",
        "operationId": "get_session_api_v1_sessions__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session"
      }
    },
    "/api/v1/sessions/{session_id}/hands": {
      "get": {
        "description": "List a session's hands in the order they were played (``client_seq``).",
        "operationId": "get_session_hands_api_v1_sessions__session_id__hands_get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HandRecord"
                  },
                  "title": "Response Get Session Hands Api V1 Sessions  Session Id  Hands Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session Hands"
      }
    },
    "/api/v1/sync": {
      "post": {
        "description": "Apply a batch item by item and report what happened to each (ADR-0026).",
        "operationId": "sync_api_v1_sync_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sync"
      }
    },
    "/api/v1/venues": {
      "get": {
        "description": "List every venue, by name.",
        "operationId": "get_venues_api_v1_venues_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VenueRecord"
                  },
                  "title": "Response Get Venues Api V1 Venues Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Venues"
      }
    }
  }
}
